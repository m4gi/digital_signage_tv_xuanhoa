<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LedConference</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Lịch họp phòng họp – UBND phường Xuân Hòa</Product>
    <!-- No .pdb next to the published exe. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pages are embedded so the published exe is a single file. -->
    <EmbeddedResource Include="web\*" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

</Project>
