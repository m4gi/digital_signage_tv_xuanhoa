<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand</item>
    </style>

    <!-- Brand blue, not black, while the page loads. -->
    <style name="AppTheme.Display" parent="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/brand</item>
    </style>

    <style name="Btn" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Btn.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/surface</item>
    </style>
    <style name="Btn.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">20dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
