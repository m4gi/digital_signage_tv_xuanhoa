<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn on top of the card the remote's arrow keys are on: a thick gold ring that reads from across the room. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#220C4DA2" />
            <stroke android:width="3dp" android:color="@color/brand" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <stroke android:width="4dp" android:color="@color/accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
