<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the pure logic is checked here (domain, storage, Excel); it compiles without the web host. -->
    <Compile Include="..\..\src\LedConference\Domain\*.cs" />
    <Compile Include="..\..\src\LedConference\Storage\*.cs" />
    <Compile Include="..\..\src\LedConference\Excel\*.cs" />
    <Compile Include="..\..\src\LedConference\Http\ServerConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

</Project>
